<UserControl
    x:Class="WinUpdater.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <ui:TextBlock
                Text="Willkommen bei WinUpdater 🚀"
                FontSize="24"
                Foreground="White"
                FontWeight="Bold" />
            <ui:TextBlock
                Text="Deine zentrale, übersichtliche Verwaltung für Windows Software-Updates via Winget."
                FontSize="14"
                Foreground="Gray"
                Margin="0,5,0,0" />
        </StackPanel>

        <Separator Grid.Row="1" Background="#333" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Padding="15" Background="#2D2D30" BorderBrush="#333" Margin="0,0,0,12">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="24" Foreground="#007ACC" Margin="0,0,15,0"
                                       VerticalAlignment="Center" />
                        <StackPanel>
                            <ui:TextBlock Text="1. Nach Updates suchen" FontSize="14" FontWeight="SemiBold"
                                          Foreground="White" />
                            <ui:TextBlock
                                Text="Wechsle links auf 'Updates' und klicke auf Suchen. Die App listet dir alle veralteten Programme übersichtlich auf."
                                Foreground="Gray" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </ui:Card>

                <ui:Card Padding="15" Background="#2D2D30" BorderBrush="#333" Margin="0,0,0,12">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="24" Foreground="#2E8B57" Margin="0,0,15,0"
                                       VerticalAlignment="Center" />
                        <StackPanel>
                            <ui:TextBlock Text="2. Gezielt auswählen" FontSize="14" FontWeight="SemiBold"
                                          Foreground="White" />
                            <ui:TextBlock
                                Text="Nutze die Checkboxen in der Tabelle, um nur die Programme zu aktualisieren, die du wirklich updaten möchtest."
                                Foreground="Gray" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </ui:Card>

                <ui:Card Padding="15" Background="#2D2D30" BorderBrush="#333" Margin="0,0,0,12">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="Document24" FontSize="24" Foreground="#E6A23C" Margin="0,0,15,0"
                                       VerticalAlignment="Center" />
                        <StackPanel>
                            <ui:TextBlock Text="3. Installierte Programme &amp; Logs einsehen" FontSize="14"
                                          FontWeight="SemiBold" Foreground="White" />
                            <ui:TextBlock
                                Text="Unter 'Installiert' siehst du deine gesamte Software. Die 'Log-Konsole' hält dich über alle Hintergrundprozesse live auf dem Laufenden."
                                Foreground="Gray" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>