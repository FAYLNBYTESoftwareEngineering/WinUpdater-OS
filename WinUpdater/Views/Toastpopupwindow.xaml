<Window
    x:Class="WinUpdater.Views.ToastPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AllowsTransparency="True"
    Background="Transparent"
    Height="90"
    Width="340"
    WindowStyle="None"
    Topmost="True"
    ShowInTaskbar="False"
    WindowStartupLocation="Manual">

    <Border
        Background="#1F1F1F"
        BorderBrush="#007ACC"
        BorderThickness="1"
        CornerRadius="8"
        Padding="16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon
                Grid.Column="0"
                Symbol="Checkmark24"
                FontSize="28"
                Foreground="#007ACC"
                VerticalAlignment="Center"
                Margin="0,0,12,0" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock
                    x:Name="TitleText"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White" />
                <ui:TextBlock
                    x:Name="MessageText"
                    FontSize="12"
                    Foreground="Gray"
                    TextWrapping="Wrap"
                    Margin="0,3,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>